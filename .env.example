# Railway sets DATABASE_URL automatically. For scripts run on the laptop, use
# the Postgres service's DATABASE_PUBLIC_URL instead.
DATABASE_URL=

# Optional: require this password (any username) to view the dashboard.
DASHBOARD_PASSWORD=

# From your Withings developer app (developer.withings.com). The callback must
# match the app's registered redirect URL exactly.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_CALLBACK_URL=https://<your-app>.up.railway.app/withings/callback

# JEFIT Open Training API: a READ-ONLY token from jefit.com settings → Access tokens
# (needs an active Elite subscription).
JEFIT_TOKEN=

# Nightly coach note and the chats.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
TZ=Australia/Melbourne

# Sign-in for chats, Sync now and check-ins. Use long random values
# (e.g. openssl rand -hex 32); the PIN is the fallback when there's no passkey.
SESSION_SECRET=
COACH_PIN=

# Claude connector (MCP): the key in the URL is the only access control.
MCP_KEY=
MCP_WRITE_KEY=
# Password for the read-only dashboard_reader role used by the SQL tool.
READONLY_DB_PASSWORD=
